# --------------------------------------------------------------------------
# REQUIRED for voice to work at all. Get a key at platform.openai.com.
# Without this, /ws/realtime immediately errors out and the frontend shows
# "Disconnected" - mic AND the typed-answer box both go dead, because both
# are relayed through this same live OpenAI connection.
# --------------------------------------------------------------------------
OPENAI_API_KEY=

# Pinned snapshot, not an auto-updating alias - confirm this string in your
# OpenAI dashboard's model list before changing it.
REALTIME_MODEL=gpt-realtime-mini
REALTIME_VOICE=alloy

# far_field = tuned for speakerphone/room mic use (this is a phone bot, not
# a headset bot). Switch to near_field only if callers will wear a headset.
REALTIME_VAD_MODE=far_field
REALTIME_VAD_TYPE=semantic_vad
REALTIME_VAD_EAGERNESS=low
REALTIME_VAD_THRESHOLD=0.7
REALTIME_VAD_SILENCE_MS=700
REALTIME_WS_URL=wss://api.openai.com/v1/realtime

# --------------------------------------------------------------------------
# Lead delivery - fill in ONE of these two blocks. Neither set = leads
# fall back to a local leads_fallback.jsonl file so nothing ever crashes.
# --------------------------------------------------------------------------

# Option A: POST straight to the existing WordPress quote form's endpoint
# (open DevTools Network tab, submit the manual form once, copy the URL here)
WP_SUBMIT_ENDPOINT=

# Option B: send an email directly
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

CORS_ORIGINS=*
LEADS_FALLBACK_FILE=leads_fallback.jsonl
APP_DB_PATH=quote_assistant.sqlite3
ABANDONED_LEAD_IDLE_SECONDS=900
ABANDONED_LEAD_SWEEP_SECONDS=120

# --------------------------------------------------------------------------
# Optional: Google Calendar booking for scheduled callbacks/visits. Leave
# GOOGLE_SERVICE_ACCOUNT_FILE blank to skip gracefully - lead capture and
# email/webhook notification still work fully without this.
# --------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=primary
CALENDAR_TIMEZONE=America/Chicago

# --------------------------------------------------------------------------
# API-as-a-service gating - OFF by default. Leave REQUIRE_API_KEY=false for
# a normal single-site deployment (the current default). ADMIN_API_SECRET
# is YOUR master secret for POSTing new client keys via /api/admin/keys -
# it is not something you hand out to customers.
# --------------------------------------------------------------------------
ADMIN_API_SECRET=
REQUIRE_API_KEY=false

# --------------------------------------------------------------------------
# Optional: real outbound phone call for "call me right now". Blank = an
# urgent lead email is still sent, just no automated dial. Needs its own
# paid Twilio account + phone number - not something this codebase can set
# up for you.
# --------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ORG_PHONE_NUMBER=
DEFAULT_COUNTRY_CODE=+91
REALTIME_CALL_END_GRACE_SECONDS=4.0